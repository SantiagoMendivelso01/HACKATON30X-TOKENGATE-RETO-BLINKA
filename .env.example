# Clave de la API de Claude para leer facturas (OCR). Sin ella, la app funciona
# pero el formulario de carga se llena a mano.
ANTHROPIC_API_KEY=

# Clave de la API de JEV (TypeSafe AI) para delegar y calibrar decisiones de pago tipadas.
JEV_API_KEY=

# Persistencia en Supabase (Project URL y clave secreta: Settings → API Keys). Solo el servidor
# las lee. Sin ellas, la app funciona en memoria y los datos se pierden al recargar.
# Antes de usarlas, corre supabase/migrations/*.sql en el SQL Editor del proyecto.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
